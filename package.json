{
  "name": "roulette13-webpixi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve": "node server.js",
    "test": "vitest run",
    "encode-alpha-video": "node scripts/encode-alpha-video.mjs",
    "roulette-video-status": "node scripts/roulette-video-status.mjs",
    "roulette-video-intake": "node scripts/roulette-video-intake.mjs",
    "test:watch": "vitest",
    "predev:all": "node scripts/check-ports.mjs --free",
    "dev:all": "concurrently --kill-others-on-fail -n BACKEND,APP,ADMIN -c yellow,blue,magenta \"npm run dev:backend\" \"npm run dev\" \"npm run dev:admin\"",
    "dev:backend": "node scripts/run-backend.mjs",
    "dev:admin": "node scripts/wait-for-admin-deps.mjs && npm --prefix admin run dev",
    "check-ports": "node scripts/check-ports.mjs",
    "free-dev-ports": "node scripts/check-ports.mjs --free",
    "check-backend": "node scripts/check-backend.mjs"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "framer-motion": "^12.43.0",
    "howler": "^2.2.4",
    "i18next": "^26.3.6",
    "matter-js": "^0.20.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.13",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
