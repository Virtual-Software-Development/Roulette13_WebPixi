VITE_API_KEY=
API_URL=
MEDIA_ROOT=./local-media
PORT=4000
# MQTT de la terminal (ver src/mqtt/mqttConnection.ts). La MAC de la computadora la lee el
# servidor local (server/terminalInfo.js) y con ella se piden las credenciales a quick-money-backend:
# GET /api/v1/mqtt-credentials/{mac}. No hace falta configurarla.
# Opcional: URL directa al broker (ej. wss://host:8084/mqtt). Vacío = mismo origen /mqtt, que
# Vite (dev) y server.js (prod) reenvían a MQTT_WS_URL. Debe ser el WebSocket del MISMO broker de
# las credenciales (ej. EMQX Cloud: wss://<host>:8084), no el puerto TCP 1883.
VITE_MQTT_URL=
MQTT_WS_URL=ws://localhost:8083
